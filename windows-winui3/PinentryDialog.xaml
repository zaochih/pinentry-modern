<Window
    x:Class="PinentryWinUI3.PinentryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pinentry Windows">

    <Grid x:Name="RootGrid" Width="420" Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="42" Height="42">
                <FontIcon
                    x:Name="DefaultIcon"
                    Glyph="&#xE72E;"
                    FontSize="30"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Image
                    x:Name="DialogIconImage"
                    Width="36"
                    Height="36"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MessageText"
                    Opacity="0.82"
                    TextWrapping="WrapWholeWords"
                    MaxHeight="180" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="ErrorBorder"
            Grid.Row="1"
            Padding="12"
            CornerRadius="6"
            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
            Visibility="Collapsed">
            <TextBlock
                x:Name="ErrorText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="WrapWholeWords" />
        </Border>

        <StackPanel x:Name="PassphrasePanel" Grid.Row="2" Spacing="8">
            <TextBlock x:Name="PromptText" FontWeight="SemiBold" />
            <PasswordBox
                x:Name="PassphraseBox"
                PasswordChanged="OnPassphraseChanged" />
            <TextBox
                x:Name="VisiblePassphraseBox"
                TextChanged="OnVisiblePassphraseChanged"
                Visibility="Collapsed" />
            <PasswordBox
                x:Name="RepeatPassphraseBox"
                PasswordChanged="OnRepeatPassphraseChanged"
                Visibility="Collapsed" />
            <TextBlock
                x:Name="MismatchText"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="The two passphrases must match."
                Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="QualityPanel" Grid.Row="3" Spacing="6" Visibility="Collapsed">
            <Grid>
                <TextBlock Text="Passphrase strength" />
                <TextBlock
                    x:Name="QualityText"
                    HorizontalAlignment="Right"
                    Opacity="0.72" />
            </Grid>
            <ProgressBar
                x:Name="QualityBar"
                Minimum="0"
                Maximum="100" />
        </StackPanel>

        <StackPanel x:Name="OptionsPanel" Grid.Row="4" Spacing="8">
            <CheckBox
                x:Name="ShowTypingCheckBox"
                Content="Show typing"
                Checked="OnShowTypingChanged"
                Unchecked="OnShowTypingChanged" />
            <CheckBox
                x:Name="SaveCredentialCheckBox"
                Content="Save in Windows Credential Manager" />
            <TextBlock
                x:Name="TimeoutText"
                Opacity="0.68"
                Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="5" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="NotOkButton"
                Grid.Column="1"
                Click="OnNotOkClick"
                Visibility="Collapsed" />
            <Button
                x:Name="CancelButton"
                Grid.Column="2"
                Click="OnCancelClick" />
            <Button
                x:Name="PrimaryButton"
                Grid.Column="3"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnPrimaryClick" />
        </Grid>
    </Grid>
</Window>
