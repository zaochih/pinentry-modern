<Window
    x:Class="PinentryWinUI3.PinentryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="WindowFrameRoot"
        Width="450"
        Background="Transparent">
        <Border
            x:Name="WindowAccentBorder"
            Width="450"
            Background="{ThemeResource PinentryDialogBackgroundBrush}"
            BorderThickness="0">
            <Grid x:Name="RootGrid" Background="{ThemeResource PinentryDialogBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HeaderTitleBarGrid"
                Grid.Row="0"
                Height="34"
                Background="{ThemeResource PinentryDialogHeaderBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="TitleBarDragRegion"
                    Padding="10,0,0,0">
                    <TextBlock
                        x:Name="WindowCaptionText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource PinentryDialogHeaderTextBrush}" />
                </Grid>
                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    Height="34"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnCancelClick">
                    <FontIcon
                        x:Name="CloseGlyph"
                        Glyph="&#xE8BB;"
                        FontSize="10"
                        Foreground="{ThemeResource PinentryDialogHeaderTextBrush}" />
                </Button>
            </Grid>

            <Border
                x:Name="HeaderContentBorder"
                Grid.Row="1"
                Background="{ThemeResource PinentryDialogHeaderBackgroundBrush}"
                Padding="20,12,20,12">
                <StackPanel>
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="20"
                        FontWeight="Normal"
                        Foreground="{ThemeResource PinentryDialogHeaderTextBrush}"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <StackPanel
                x:Name="ContentPanel"
                Grid.Row="2"
                Padding="20,22,20,24"
                Background="{ThemeResource PinentryDialogBackgroundBrush}"
                Spacing="16">
            <Grid x:Name="SourceInfoGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SourceIconColumn" Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="SourceIconHost"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <FontIcon
                        x:Name="DefaultIcon"
                        Glyph="&#xE72E;"
                        FontSize="24"
                        Foreground="{ThemeResource PinentryDialogAccentBrush}" />
                    <Image
                        x:Name="DialogIconImage"
                        Width="34"
                        Height="34"
                        Stretch="Uniform"
                        Visibility="Collapsed" />
                </Grid>

                <TextBlock
                    x:Name="SourceNameText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="Normal"
                    Foreground="{ThemeResource PinentryDialogPrimaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </Grid>

            <TextBlock
                x:Name="MessageText"
                FontSize="14"
                FontWeight="Normal"
                Foreground="{ThemeResource PinentryDialogPrimaryTextBrush}"
                TextWrapping="WrapWholeWords"
                MaxHeight="220" />

            <Border
                x:Name="ErrorBorder"
                Padding="14,12"
                Background="{ThemeResource PinentryDialogErrorBackgroundBrush}"
                BorderBrush="{ThemeResource PinentryDialogErrorBorderBrush}"
                BorderThickness="1"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="ErrorText"
                    FontSize="14"
                    Foreground="{ThemeResource PinentryDialogErrorTextBrush}"
                    TextWrapping="WrapWholeWords" />
            </Border>

            <StackPanel x:Name="PassphrasePanel" Spacing="10">
                <PasswordBox
                    x:Name="PassphraseBox"
                    FontSize="14"
                    MinHeight="32"
                    KeyDown="OnPassphraseKeyDown"
                    PasswordChanged="OnPassphraseChanged" />
                <TextBox
                    x:Name="VisiblePassphraseBox"
                    FontSize="14"
                    MinHeight="32"
                    KeyDown="OnPassphraseKeyDown"
                    TextChanged="OnVisiblePassphraseChanged"
                    Visibility="Collapsed" />
                <PasswordBox
                    x:Name="RepeatPassphraseBox"
                    FontSize="14"
                    MinHeight="32"
                    KeyDown="OnPassphraseKeyDown"
                    PasswordChanged="OnRepeatPassphraseChanged"
                    Visibility="Collapsed" />
                <TextBlock
                    x:Name="MismatchText"
                    FontSize="14"
                    Foreground="{ThemeResource PinentryDialogErrorTextBrush}"
                    Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="QualityPanel" Spacing="8" Visibility="Collapsed">
                <Grid>
                    <TextBlock
                        x:Name="QualityTitleText"
                        FontSize="14"
                        Foreground="{ThemeResource PinentryDialogPrimaryTextBrush}" />
                    <TextBlock
                        x:Name="QualityText"
                        FontSize="14"
                        HorizontalAlignment="Right"
                        Foreground="{ThemeResource PinentryDialogSecondaryTextBrush}" />
                </Grid>
                <ProgressBar
                    x:Name="QualityBar"
                    Minimum="0"
                    Maximum="100" />
            </StackPanel>

            <StackPanel x:Name="OptionsPanel" Spacing="8">
                <CheckBox
                    x:Name="ShowTypingCheckBox"
                    FontSize="14"
                    Checked="OnShowTypingChanged"
                    Unchecked="OnShowTypingChanged" />
                <CheckBox
                    x:Name="SaveCredentialCheckBox"
                    FontSize="14" />
                <TextBlock
                    x:Name="TimeoutText"
                    FontSize="14"
                    Foreground="{ThemeResource PinentryDialogSecondaryTextBrush}"
                    Visibility="Collapsed" />
            </StackPanel>
            </StackPanel>

            <Border
                x:Name="FooterBorder"
                Grid.Row="3"
                Background="{ThemeResource PinentryDialogFooterBackgroundBrush}"
                Padding="20,22">
            <Grid
                x:Name="ActionButtonsGrid"
                ColumnSpacing="12"
                RowSpacing="0"
                HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="NotOkButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="32"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    FontSize="14"
                    Click="OnNotOkClick"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CancelButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Height="32"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    FontSize="14"
                    Click="OnCancelClick" />
                <Button
                    x:Name="PrimaryButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="32"
                    MinWidth="0"
                    HorizontalAlignment="Stretch"
                    FontSize="14"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnPrimaryClick" />
            </Grid>
            </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
