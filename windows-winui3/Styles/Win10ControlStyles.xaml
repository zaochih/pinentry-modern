<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PinentryWin10ControlBorderBrush" Color="#999999" />
            <SolidColorBrush x:Key="PinentryWin10ButtonBackgroundBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="PinentryWin10ButtonBackgroundPointerOverBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="PinentryWin10ButtonBackgroundPressedBrush" Color="#A8A8A8" />
            <SolidColorBrush x:Key="PinentryDialogBackgroundBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="PinentryDialogHeaderBackgroundBrush" Color="#76B9ED" />
            <SolidColorBrush x:Key="PinentryDialogFooterBackgroundBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="PinentryDialogHeaderTextBrush" Color="#111111" />
            <SolidColorBrush x:Key="PinentryDialogPrimaryTextBrush" Color="#111111" />
            <SolidColorBrush x:Key="PinentryDialogSecondaryTextBrush" Color="#5E5E5E" />
            <SolidColorBrush x:Key="PinentryWin10ButtonHoverBorderBrush" Color="#6E6E6E" />
            <SolidColorBrush x:Key="PinentryWin10ButtonFocusBorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#B8B8B8" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B8B8B8" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A8A8A8" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#666666" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#6E6E6E" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#A8A8A8" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#666666" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#111111" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#111111" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#111111" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#666666" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A8A8A8" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#666666" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#B8B8B8" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#6E6E6E" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#A8A8A8" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#666666" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#111111" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#111111" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#111111" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#666666" />
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#E6E6E6" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PinentryWin10ControlBorderBrush" Color="#999999" />
            <SolidColorBrush x:Key="PinentryWin10ButtonBackgroundBrush" Color="#4C4C4C" />
            <SolidColorBrush x:Key="PinentryWin10ButtonBackgroundPointerOverBrush" Color="#4C4C4C" />
            <SolidColorBrush x:Key="PinentryWin10ButtonBackgroundPressedBrush" Color="#404040" />
            <SolidColorBrush x:Key="PinentryDialogBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="PinentryDialogHeaderBackgroundBrush" Color="#76B9ED" />
            <SolidColorBrush x:Key="PinentryDialogFooterBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="PinentryDialogHeaderTextBrush" Color="#111111" />
            <SolidColorBrush x:Key="PinentryDialogPrimaryTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PinentryDialogSecondaryTextBrush" Color="#CFCFCF" />
            <SolidColorBrush x:Key="PinentryWin10ButtonHoverBorderBrush" Color="#949494" />
            <SolidColorBrush x:Key="PinentryWin10ButtonFocusBorderBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackground" Color="#4C4C4C" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4C4C4C" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#404040" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#333333" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4C4C4C" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#949494" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#404040" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#333333" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#999999" />
            <SolidColorBrush x:Key="AccentButtonBackground" Color="#4C4C4C" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#4C4C4C" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#404040" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#333333" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#4C4C4C" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#949494" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#404040" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#333333" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#999999" />
            <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#1F1F1F" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="TextControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CheckBoxCheckBoxCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CheckBoxCheckBackgroundCornerRadius">0</CornerRadius>

    <Thickness x:Key="ButtonBorderThemeThickness">2</Thickness>
    <Thickness x:Key="TextControlBorderThemeThickness">2</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    <x:Double x:Key="CheckBoxBorderThemeThickness">2</x:Double>
    <x:Double x:Key="CheckBoxCheckedStrokeThickness">2</x:Double>
    <x:Double x:Key="CheckBoxCheckBoxStrokeThickness">2</x:Double>
    <x:Double x:Key="CheckBoxCheckBackgroundStrokeThickness">2</x:Double>
    <x:Double x:Key="CheckBoxCheckBackgroundStrokeThicknessPointerOver">2</x:Double>
    <x:Double x:Key="CheckBoxCheckBackgroundStrokeThicknessPressed">2</x:Double>
    <x:Double x:Key="CheckBoxCheckBackgroundStrokeThicknessDisabled">2</x:Double>

    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#999999" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#999999" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#999999" />

    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUnchecked" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUnchecked" Color="#999999" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPointerOver" Color="#999999" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedPressed" Color="#999999" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeUncheckedDisabled" Color="#999999" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedDisabled" Color="Transparent" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedDisabled" Color="#999999" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedDisabled" Color="#999999" />

    <Thickness x:Key="FocusVisualMargin">2</Thickness>
    <Thickness x:Key="ButtonFocusVisualMargin">2</Thickness>

    <Style x:Key="PinentryWin10ButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{ThemeResource PinentryWin10ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PinentryWin10ButtonBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource PinentryWin10ButtonStyle}" />

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PinentryWin10ButtonStyle}">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{ThemeResource PinentryWin10ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PinentryWin10ButtonBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{ThemeResource ButtonForeground}" />
    </Style>
</ResourceDictionary>
