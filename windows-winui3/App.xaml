<Application
    x:Class="PinentryWinUI3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PinentryDialogBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PinentryDialogHeaderBackgroundBrush" Color="#E7E7E7" />
                    <SolidColorBrush x:Key="PinentryDialogFooterBackgroundBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="PinentryDialogPrimaryTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="PinentryDialogSecondaryTextBrush" Color="#5E5E5E" />
                    <SolidColorBrush x:Key="PinentryDialogAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="PinentryDialogErrorBackgroundBrush" Color="#FDE7E9" />
                    <SolidColorBrush x:Key="PinentryDialogErrorBorderBrush" Color="#F3B5BB" />
                    <SolidColorBrush x:Key="PinentryDialogErrorTextBrush" Color="#A4262C" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PinentryDialogBackgroundBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="PinentryDialogHeaderBackgroundBrush" Color="#373737" />
                    <SolidColorBrush x:Key="PinentryDialogFooterBackgroundBrush" Color="#131313" />
                    <SolidColorBrush x:Key="PinentryDialogPrimaryTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PinentryDialogSecondaryTextBrush" Color="#CFCFCF" />
                    <SolidColorBrush x:Key="PinentryDialogAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="PinentryDialogErrorBackgroundBrush" Color="#442326" />
                    <SolidColorBrush x:Key="PinentryDialogErrorBorderBrush" Color="#8C3A42" />
                    <SolidColorBrush x:Key="PinentryDialogErrorTextBrush" Color="#FFB3BA" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PinentryDialogBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PinentryDialogHeaderBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PinentryDialogFooterBackgroundBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="PinentryDialogPrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PinentryDialogSecondaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PinentryDialogAccentBrush" Color="{ThemeResource SystemAccentColor}" />
                    <SolidColorBrush x:Key="PinentryDialogErrorBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PinentryDialogErrorBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="PinentryDialogErrorTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
